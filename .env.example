# --- Apps Script API (lihat apps-script/README-APPS-SCRIPT.md) ---
APPS_SCRIPT_URL=https://script.google.com/macros/s/XXXXXXXX/exec
# Isi sama persis dengan Script Property API_SECRET di Apps Script. Acak, minimal 32 karakter.
APPS_SCRIPT_SECRET=

# --- Login Google (Google Cloud Console > Credentials > OAuth client) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- NextAuth ---
# Buat dengan: openssl rand -base64 32
NEXTAUTH_SECRET=
# Lokal: http://localhost:3000 . Di Vercel: alamat situs Anda (https://xxx.vercel.app)
NEXTAUTH_URL=http://localhost:3000

# --- Hanya untuk uji lokal tanpa Google & tanpa Apps Script (diabaikan di produksi) ---
# DEV_MOCK=1
