@import url("https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@600;700;800&family=DM+Sans:wght@400;500;700&display=swap");
:root {
  --bg: #faf6f0; --surface: #ffffff; --ink: #2a2420; --muted: #7a6f66; --line: #eadfce;
  --brand: #d9622b; --brand-ink: #ffffff; --brand-soft: #fbe7da;
  --ok: #2f8f5b; --ok-soft: #dff2e6; --warn: #b7791f; --warn-soft: #fbefd0; --bad: #c0392b; --bad-soft: #f9dcd8;
  --radius: 14px; --shadow: 0 1px 2px rgba(60,40,20,.06), 0 6px 20px rgba(60,40,20,.05);
}

* { box-sizing: border-box; }
html, body { margin: 0; background: var(--bg); color: var(--ink); }
body { font: 16px/1.5 ui-rounded, "Segoe UI", system-ui, -apple-system, Roboto, sans-serif; -webkit-font-smoothing: antialiased; }
a { color: inherit; text-decoration: none; }
h1 { font-size: 1.75rem; line-height: 1.2; margin: 0 0 .25rem; letter-spacing: -.01em; }
h2 { font-size: 1.1rem; margin: 0; }
.muted { color: var(--muted); }
.wrap { max-width: 980px; margin: 0 auto; padding: 24px 16px 64px; }

.topbar { background: var(--surface); border-bottom: 1px solid var(--line); }
.topbar .in { max-width: 980px; margin: 0 auto; padding: 12px 16px; display: flex; align-items: center; gap: 16px; flex-wrap: wrap; }
.brand { font-weight: 800; color: var(--brand); letter-spacing: -.01em; }
.topbar nav { display: flex; gap: 4px; flex: 1; flex-wrap: wrap; }
.topbar nav a { padding: 6px 12px; border-radius: 999px; color: var(--muted); font-size: .92rem; }
.topbar nav a:hover, .topbar nav a.on { background: var(--brand-soft); color: var(--brand); }
.who { font-size: .85rem; color: var(--muted); display: flex; gap: 10px; align-items: center; }

.btn { display: inline-flex; align-items: center; gap: 8px; border: 0; cursor: pointer; font: inherit; font-weight: 600;
  background: var(--brand); color: var(--brand-ink); padding: 10px 18px; border-radius: 999px; }
.btn:hover { filter: brightness(1.05); }
.btn:disabled { opacity: .55; cursor: default; }
.btn.ghost { background: transparent; color: var(--muted); border: 1px solid var(--line); padding: 6px 12px; font-weight: 500; font-size: .85rem; }

.grid { display: grid; gap: 14px; }
.menu { grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); margin-top: 20px; }
.card { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); box-shadow: var(--shadow); padding: 18px; }
a.card:hover { border-color: var(--brand); }
.card .emoji { font-size: 1.6rem; }
.card h2 { margin: 8px 0 2px; }
.card.soon { opacity: .6; }
.tag { font-size: .72rem; background: var(--brand-soft); color: var(--brand); padding: 2px 8px; border-radius: 999px; margin-left: 6px; font-weight: 600; }

.tiles { grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); margin: 18px 0; }
.tile .n { font-size: 1.9rem; font-weight: 800; line-height: 1.1; }
.tile .l { font-size: .82rem; color: var(--muted); }
.meter { height: 10px; background: var(--line); border-radius: 99px; overflow: hidden; margin-top: 8px; }
.meter > i { display: block; height: 100%; background: var(--ok); }

.banner { border-radius: 12px; padding: 12px 14px; margin: 10px 0; font-size: .93rem; }
.banner.alert { background: var(--bad-soft); color: var(--bad); }
.banner.rule { background: var(--warn-soft); color: var(--warn); }

.block { margin-top: 26px; }
.block > h2 { margin-bottom: 10px; }
.kpi { display: grid; grid-template-columns: 1fr auto; gap: 8px 16px; padding: 14px 0; border-top: 1px solid var(--line); }
.kpi:first-of-type { border-top: 0; }
.kpi .name { font-weight: 650; }
.kpi .meta { font-size: .83rem; color: var(--muted); }
.kpi .nums { text-align: right; font-variant-numeric: tabular-nums; }
.kpi .nums b { font-size: 1.15rem; }
.chip { display: inline-block; font-size: .75rem; font-weight: 700; padding: 2px 10px; border-radius: 99px; }
.chip.ok { background: var(--ok-soft); color: var(--ok); }
.chip.warn { background: var(--warn-soft); color: var(--warn); }
.chip.bad { background: var(--bad-soft); color: var(--bad); }
.chip.na { background: var(--line); color: var(--muted); }
.spark { grid-column: 1 / -1; display: flex; gap: 3px; align-items: flex-end; height: 28px; }
.spark i { flex: 1; min-width: 4px; border-radius: 3px; background: var(--line); height: 30%; }
.spark i.ok { background: var(--ok); height: 100%; } .spark i.warn { background: var(--warn); height: 70%; } .spark i.bad { background: var(--bad); height: 45%; }

.toolbar { display: flex; gap: 12px; align-items: flex-end; flex-wrap: wrap; margin: 16px 0; }
label.f { display: grid; gap: 4px; font-size: .85rem; color: var(--muted); }
input[type="date"], input[type="number"], input[type="text"] { font: inherit; color: var(--ink); background: var(--surface);
  border: 1px solid var(--line); border-radius: 10px; padding: 9px 12px; }
input:focus-visible, .btn:focus-visible, a:focus-visible { outline: 2px solid var(--brand); outline-offset: 2px; }
.row { display: grid; grid-template-columns: 1fr 140px; gap: 12px; align-items: center; padding: 10px 0; border-top: 1px solid var(--line); }
.row:first-of-type { border-top: 0; }
.row input { width: 100%; text-align: right; }
.toast { position: sticky; bottom: 16px; margin-top: 16px; padding: 12px 16px; border-radius: 12px; font-weight: 600; }
.toast.ok { background: var(--ok-soft); color: var(--ok); } .toast.err { background: var(--bad-soft); color: var(--bad); }
.center { min-height: 100vh; display: grid; place-items: center; padding: 16px; }
.login { max-width: 400px; text-align: center; }
.empty { text-align: center; padding: 40px 16px; color: var(--muted); }
@media (max-width: 520px) { h1 { font-size: 1.45rem; } .row { grid-template-columns: 1fr 110px; } }

.form { display: grid; gap: 14px; text-align: left; margin-top: 16px; }
.form input[type="email"], .form input[type="password"] { width: 100%; font: inherit; color: var(--ink); background: var(--surface);
  border: 1px solid var(--line); border-radius: 10px; padding: 10px 12px; }
.form input:focus-visible { outline: 2px solid var(--brand); outline-offset: 2px; }
.form .btn { justify-content: center; }
.hint { font-size: .82rem; color: var(--muted); }
.narrow { max-width: 460px; }

.topbar nav{display:flex;gap:4px;overflow-x:auto;white-space:nowrap;min-width:0;flex:1;scrollbar-width:thin}
.topbar nav a.soon{opacity:.7}
.topbar nav{flex-wrap:nowrap}.topbar nav a{flex:none}

.topbar nav{flex-wrap:nowrap}.topbar nav a{flex:none}
.formgrid{display:grid;gap:12px;grid-template-columns:repeat(auto-fit,minmax(220px,1fr))}
.formgrid input,.formgrid select,textarea{width:100%;box-sizing:border-box}
select,textarea{font:inherit;color:var(--ink);background:var(--surface);border:1px solid var(--line);border-radius:10px;padding:8px 10px}
.rock{margin-top:14px;display:grid;gap:8px}
.rock p{margin:0}
.rock .top{display:flex;justify-content:space-between;gap:12px;align-items:flex-start}
.rock .judul{font-weight:700}
.rock .meta{font-size:.85rem}
.rock .aksi{display:flex;gap:8px;align-items:center;flex-wrap:wrap}

/* TEMA MAZARIN */

:root {
  color-scheme: light;
  --bg: #F1EFE8; --surface: #ffffff; --ink: #0F2A3D; --muted: #5B6F7D; --line: #DDD9CC;
  --brand: #1D9E75; --brand-ink: #ffffff; --brand-soft: #DDF2EA;
  --ok: #0E7A59; --ok-soft: #DDF2EA; --warn: #8A5A10; --warn-soft: #FCEBCF; --bad: #A8321F; --bad-soft: #F7DAD6;
  --navy: #0F2A3D; --amber: #F2A33A; --emerald: #1D9E75;
  --radius: 10px; --shadow: none;
}
body { font-family: "DM Sans", system-ui, "Segoe UI", sans-serif; }
h1, h2, .tile .n, .brand, .rock .judul, .cincin-n { font-family: "Bricolage Grotesque", "DM Sans", sans-serif; letter-spacing: -.01em; }
h1 { font-size: 1.9rem; font-weight: 800; }
.wrap { max-width: 1040px; }

/* Topbar */
.topbar { background: var(--navy); border-bottom: 3px solid var(--emerald); }
.topbar .brand { display: flex; align-items: center; gap: 10px; color: #F1EFE8; font-size: 1rem; font-weight: 700; }
.topbar .brand svg { color: #F1EFE8; flex: none; }
.topbar nav { flex-wrap: wrap; overflow: visible; white-space: normal; gap: 2px; }
.topbar nav a { color: rgba(241,239,232,.78); border-radius: 8px; padding: 6px 11px; }
.topbar nav a:hover { background: rgba(255,255,255,.10); color: #fff; }
.topbar nav a.on { background: rgba(255,255,255,.14); color: #fff; box-shadow: inset 0 -3px 0 var(--emerald); border-radius: 8px 8px 0 0; }
.topbar nav a.soon { opacity: .5; }
.topbar .who { color: rgba(241,239,232,.8); }
.topbar .who .btn.ghost { color: #F1EFE8; border-color: rgba(241,239,232,.35); }
.topbar .who .btn.ghost:hover { background: rgba(255,255,255,.10); }

/* Header halaman */
.hero { position: relative; overflow: hidden; background: #fff; border: 1px solid var(--line); border-left: 6px solid var(--emerald);
  border-radius: var(--radius); padding: 22px 24px; margin: 4px 0 18px; }
.hero > *:not(.hero-art) { position: relative; }
.hero .kicker { font-size: .72rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--emerald); }
.hero h1 { margin: 4px 0 6px; }
.hero p { margin: 0; max-width: 62ch; }
.hero-art { position: absolute; right: -14px; top: -26px; color: var(--navy); opacity: .08; pointer-events: none; }

/* Analitik */
.analitik { display: grid; gap: 14px; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); margin: 0 0 20px; }
.analitik .card { padding: 16px 18px; }
.judul-kartu { font-size: .7rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--muted); margin-bottom: 12px; }
.cincin { display: flex; align-items: center; gap: 16px; }
.cincin svg { width: 112px; height: 112px; flex: none; }
.cincin-n { font-size: 24px; font-weight: 800; fill: var(--navy); }
.cincin-l { font-weight: 700; }
.dua { display: grid; gap: 18px; }
.pj { font-size: .85rem; font-weight: 700; margin-bottom: 8px; }
.stack { display: flex; height: 14px; border-radius: 99px; overflow: hidden; background: var(--line); }
.stack i { display: block; height: 100%; }
.stack i + i { border-left: 2px solid #fff; }
.legenda { list-style: none; margin: 10px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px 14px; font-size: .82rem; color: var(--muted); }
.legenda b { color: var(--ink); margin-left: 2px; }
.dot { display: inline-block; width: 9px; height: 9px; border-radius: 50%; margin-right: 6px; }
.beban { display: grid; gap: 10px; }
.beban-baris { display: grid; grid-template-columns: 170px 1fr 28px; gap: 10px; align-items: center; font-size: .85rem; }
.beban-baris > .beban-isi { grid-column: 2; }
.beban-nama { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.beban-isi { display: flex; height: 12px; border-radius: 99px; overflow: hidden; min-width: 12px; }
.beban-isi i { display: block; }
.beban-angka { text-align: right; font-weight: 700; }
.evaluasi { grid-column: 1 / -1; }
.wawasan { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
.wawasan li { display: flex; gap: 10px; align-items: flex-start; padding: 10px 12px; border-radius: 8px; font-size: .93rem; border-left: 4px solid var(--line); }
.wawasan .ikon { font-weight: 800; width: 18px; flex: none; text-align: center; }
.wawasan li.ok { background: var(--ok-soft); border-color: var(--emerald); color: #0B5A41; }
.wawasan li.warn { background: var(--warn-soft); border-color: var(--amber); color: #6E4710; }
.wawasan li.bad { background: var(--bad-soft); border-color: #C0392B; color: #8E2A1F; }

/* Tombol */
.btn { background: var(--navy); color: #fff; border-radius: 8px; padding: 9px 16px; }
.btn:hover { background: #17415C; filter: none; }
.btn.ghost { background: transparent; color: var(--ink); border: 1px solid var(--line); border-radius: 8px; }
.btn.ghost:hover { background: #fff; border-color: var(--navy); }
.toolbar > .btn { background: var(--amber); color: var(--navy); margin-left: auto; }
.toolbar > .btn:hover { background: #E59A30; }
.toolbar > .btn:disabled { opacity: .5; }
a:focus-visible, .btn:focus-visible, input:focus-visible, select:focus-visible, textarea:focus-visible { outline: 2px solid var(--amber); outline-offset: 2px; }

/* Kartu dan papan skor */
.card { border-radius: var(--radius); }
.tile { border-top: 4px solid var(--navy); padding: 16px; }
.tile:nth-child(2) { border-top-color: var(--emerald); }
.tile:nth-child(3) { border-top-color: var(--amber); }
.tile:nth-child(4) { border-top-color: #C0392B; }
.tile .n { font-size: 2.2rem; font-weight: 800; }
.tile .l { text-transform: uppercase; letter-spacing: .06em; font-size: .72rem; margin-top: 4px; }
.meter { height: 8px; }
.meter > i { background: var(--emerald); }
.card.rock { border-left: 5px solid var(--line); padding: 16px 18px; }
.card.rock:has(.chip.ok) { border-left-color: var(--emerald); }
.card.rock:has(.chip.warn) { border-left-color: var(--amber); }
.card.rock:has(.chip.bad) { border-left-color: #C0392B; }
.rock .judul { font-size: 1.1rem; font-weight: 700; }
label.f { color: var(--ink); font-weight: 700; }
.formgrid input, .formgrid select, select, textarea { border-radius: 8px; }

/* Beranda */
.menu .card { border-top: 4px solid var(--emerald); }
.menu a.card { transition: transform .15s, border-color .15s; }
.menu a.card:hover { border-color: var(--navy); border-top-color: var(--amber); transform: translateY(-2px); }
.menu .card .emoji { width: 44px; height: 44px; display: grid; place-items: center; background: var(--brand-soft); border-radius: 10px; font-size: 1.3rem; }
.menu .card.soon { border-top-color: var(--line); }
@media (prefers-reduced-motion: reduce) { .menu a.card { transition: none; } .menu a.card:hover { transform: none; } }