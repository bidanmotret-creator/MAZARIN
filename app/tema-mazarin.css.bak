@import url("https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@600;700;800&family=DM+Sans:wght@400;500;700&display=swap");

/* Tema Mazarin (gaya EOS): menimpa variabel di globals.css, selalu mode terang */
:root {
  color-scheme: light;
  --bg: #F1EFE8; --surface: #ffffff; --ink: #0F2A3D; --muted: #5B6F7D; --line: #DDD9CC;
  --brand: #1D9E75; --brand-ink: #ffffff; --brand-soft: #DDF2EA;
  --ok: #0E7A59; --ok-soft: #DDF2EA;
  --warn: #8A5A10; --warn-soft: #FCEBCF;
  --bad: #A8321F; --bad-soft: #F7DAD6;
  --navy: #0F2A3D; --amber: #F2A33A; --emerald: #1D9E75;
  --radius: 10px; --shadow: none;
}

body { font-family: "DM Sans", system-ui, "Segoe UI", sans-serif; }
h1, h2, .tile .n, .brand, .rock .judul { font-family: "Bricolage Grotesque", "DM Sans", sans-serif; letter-spacing: -.01em; }
h1 { font-size: 1.9rem; font-weight: 800; }
.wrap { max-width: 1040px; }

/* Topbar navy, menu turun baris supaya semua tab terlihat */
.topbar { background: var(--navy); border-bottom: 3px solid var(--emerald); }
.topbar .brand { color: #F1EFE8; font-size: 1.05rem; }
.topbar nav { flex-wrap: wrap; overflow: visible; white-space: normal; gap: 2px; }
.topbar nav a { color: rgba(241,239,232,.78); border-radius: 8px; padding: 6px 11px; }
.topbar nav a:hover { background: rgba(255,255,255,.10); color: #fff; }
.topbar nav a.on { background: rgba(255,255,255,.14); color: #fff; box-shadow: inset 0 -3px 0 var(--emerald); border-radius: 8px 8px 0 0; }
.topbar nav a.soon { opacity: .5; }
.topbar .who { color: rgba(241,239,232,.8); }
.topbar .who .btn.ghost { color: #F1EFE8; border-color: rgba(241,239,232,.35); }
.topbar .who .btn.ghost:hover { background: rgba(255,255,255,.10); }

/* Tombol: navy untuk aksi biasa, amber hanya untuk CTA tambah */
.btn { background: var(--navy); color: #fff; border-radius: 8px; padding: 9px 16px; }
.btn:hover { background: #17415C; filter: none; }
.btn.ghost { background: transparent; color: var(--ink); border: 1px solid var(--line); border-radius: 8px; }
.btn.ghost:hover { background: #fff; border-color: var(--navy); }
.toolbar > .btn { background: var(--amber); color: var(--navy); margin-left: auto; }
.toolbar > .btn:hover { background: #E59A30; }
.toolbar > .btn:disabled { opacity: .5; }
a:focus-visible, .btn:focus-visible, input:focus-visible, select:focus-visible, textarea:focus-visible { outline: 2px solid var(--amber); outline-offset: 2px; }

/* Kartu dan papan skor */
.card { border-radius: var(--radius); }
.tile { border-top: 4px solid var(--navy); padding: 16px; }
.tile:nth-child(2) { border-top-color: var(--emerald); }
.tile .n { font-size: 2.2rem; font-weight: 800; }
.tile .l { text-transform: uppercase; letter-spacing: .06em; font-size: .72rem; margin-top: 4px; }
.meter { height: 8px; }
.meter > i { background: var(--emerald); }

/* Baris Rock, Issue, To-Do: garis status di kiri */
.card.rock { border-left: 5px solid var(--line); padding: 16px 18px; }
.card.rock:has(.chip.ok) { border-left-color: var(--emerald); }
.card.rock:has(.chip.warn) { border-left-color: var(--amber); }
.card.rock:has(.chip.bad) { border-left-color: #C0392B; }
.rock .judul { font-size: 1.1rem; font-weight: 700; }
.chip.warn { background: var(--warn-soft); color: var(--warn); }

/* Form */
.formgrid input, .formgrid select, select, textarea { border-radius: 8px; }
label.f { color: var(--ink); font-weight: 700; }